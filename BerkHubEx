-- Adding hover effects using TweenService for button animations
local TweenService = game:GetService("TweenService")

local function createHoverEffect(button)
    button.MouseEnter:Connect(function()
        local goal = {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}
        local tween = TweenService:Create(button, TweenInfo.new(0.2), goal)
        tween:Play()
    end)
    button.MouseLeave:Connect(function()
        local goal = {BackgroundColor3 = button.BackgroundColor3}
        local tween = TweenService:Create(button, TweenInfo.new(0.2), goal)
        tween:Play()
    end)
end

createHoverEffect(Execute)
createHoverEffect(Clear)
createHoverEffect(ExitButton)
createHoverEffect(CloseButton)
